{
  "_note": "Mix灾害预警插件 — 数据源注册目录。每次 parser 新增/修改时同步更新此文件。",
  "_field_docs": {
    "_legend": "以下字段适用于 sources.json 中的每个数据源条目。必填字段以 ★ 标记。",
    "source_id": "★ 数据源唯一标识。对应 parser/registry.py 中 @ParserRegistry.register('id') 的 id。全局唯一，一经确定不要改名。",
    "source_type": "★ 领域数据类型。决定该数据源产出哪种事件模型。可选值见 _schema._source_type。",
    "provider_family": "★ 连接提供方家族。决定该源走哪个连接处理器。可选值见 _schema._provider_family。",
    "parser_name": "★ 解析器注册名。对应 parser/xxx.py 中 @ParserRegistry.register('name') 的 name。router 根据此值查找解析器。",
    "presentation_type": "★ 卡片展示类型。message/presenters.py 根据此值选择对应的格式器。",
    "config_group": "★ 配置父组名。对应 AstrBot 插件配置 JSON 的一级键，如 data_sources.fan_studio。",
    "config_key": "★ 配置开关 Key。对应 AstrBot 插件配置中该源的启用开关，如 data_sources.fan_studio.china_earthquake_warning。",
    "priority": "展示优先级。数值越大越优先。同一类型（如多个 EEW 源）中高优先级的排前面。",
    "display_name": "人类可读的展示名称。用于命令回复、卡片标题等用户可见的地方。",
    "description": "数据源详细描述。说明该源覆盖范围、数据特点等。",
    "default_timezone": "该数据源事件时间的默认时区。解析器据此解释无时区标注的时间字符串。",
    "connection_handler": "连接处理器类型。router 根据此值将原始消息路由到正确的 WebSocket 或 HTTP 处理器。",
    "connection_url": "主连接地址（WebSocket URL 或 HTTP API URL）。",
    "connection_backup_url": "备用连接地址。主连接失败时自动切换。可为空。",
    "institution_key": "机构统一标识键。用于跨多个数据源归并为同一机构（如 jma_fanstudio 和 jma_wolfx 的 institution_key 都是 jma）。",
    "code_override": "显示代码覆盖。制定标题 CODE 前缀的精确写法（含大小写），不填时自动用 institution_key.upper()。如 \"GlobalQuake\"、\"GeoNet\"。",
    "institution_display_name": "机构完整显示名。用于查询结果和管理端展示。",
    "institution_active_name": "机构日常简称。用于卡片/消息中的简短显示。",
    "query_group": "查询分组。决定该源出现在哪个查询命令的结果中：eew→/地震预警, earthquake→/地震列表, weather→/气象预警, typhoon→/台风。空字符串表示不参与分组查询。",
    "dispatch_family": "消息分发流派。pipeline 根据此值决定走哪条推送路径（如 fan_studio_eew / fan_studio_report / wolfx_eew）。",
    "provider_source_names": "提供方定义的来源名列表。用于在 FAN Studio 等聚合源中根据 source 字段匹配到正确的子解析器。",
    "provider_aliases": "别名列表。router 在路由匹配时也检查这些别名。",
    "routing_tags": "路由标签。供 router 和 pipeline 做批量分类过滤使用。",
    "payload_signatures": "载荷签名字段组。原始消息同时包含某组中的所有字段时，router 判定匹配该源。支持多组（多组之间是 OR 关系）。",
    "payload_exclusions": "载荷排除签名字段组。原始消息包含某组中的任一字段时，router 排除该源。"
  },
  "_schema": {
    "_source_type": "earthquake_warning | earthquake_info | tsunami | weather | typhoon",
    "_provider_family": "fan_studio | wolfx | p2p | global_quake | direct_http",
    "_query_group": "eew | earthquake | weather | typhoon | tsunami | \"\""
  },
