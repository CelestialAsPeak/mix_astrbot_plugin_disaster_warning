    # ═══════════════════ 辅助 ═══════════════════

    async def _is_admin(self, event: AstrMessageEvent) -> bool:
        try:
            admins = self.config.get("admin_users", [])
            return event.get_sender_id() in admins
        except Exception:
            return False

    async def on_astrbot_loaded(self):
        logger.debug("[Mix] 准备就绪")
