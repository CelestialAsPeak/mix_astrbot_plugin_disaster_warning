# ── 数据库查询 — 读旧版 events.db ──

_DB_PATH = Path(
    r"C:\Users\ZhuanZ.DESKTOP-PH97BKO\.astrbot\data\plugin_data"
    r"\mix_astrbot_plugin_disaster_warning\events.db"
)
_executor = ThreadPoolExecutor(max_workers=2)


def _db_query(sql: str, params: tuple = ()) -> list[dict]:
    """同步 SQLite 查询（在 executor 中跑）。"""
    if not _DB_PATH.exists():
        return []
    conn = sqlite3.connect(str(_DB_PATH))
    conn.row_factory = sqlite3.Row
    try:
        c = conn.cursor()
        c.execute(sql, params)
        return [dict(r) for r in c.fetchall()]
    finally:
        conn.close()


async def _db_query_async(sql: str, params: tuple = ()) -> list[dict]:
    """异步查询包装。"""
    loop = asyncio.get_running_loop()
    return await loop.run_in_executor(_executor, _db_query, sql, params)


def _format_time_short(ts: str | None) -> str:
    """时间戳截取到 时:分。"""
    if not ts:
        return ""
    try:
        return ts[11:16] if "T" in ts else ts[5:16]
    except IndexError:
        return ts[:16] if ts else ""


